---
import '@fontsource-variable/archivo/standard.css';
import '@/styles/tokens.css';
import '@/styles/base.css';
import './landing.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import { THEME_BOOT_SCRIPT } from '@/lib/theme';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  ogImageAlt: string;
}

const { title, description, ogImage, ogImageAlt } = Astro.props;
const siteSetting = Astro.site?.href ?? (import.meta.env['PUBLIC_SITE_URL'] as string | undefined);
const site = siteSetting ? new URL(siteSetting) : null;
const canonical = site ? new URL(Astro.url.pathname, site).href : null;
const ogImageUrl = site ? new URL(ogImage, site).href : ogImage;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f7f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191c1e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Paginator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <slot name="head" />
  </head>
  <body class="landing">
    <slot />
  </body>
</html>
