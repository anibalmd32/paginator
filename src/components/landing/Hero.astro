---
import { HeroMagazine } from './HeroMagazine';
---

<section class="hero" aria-labelledby="titular">
  <div class="intro">
    <h1 id="titular" class="l-display"><span class="line">Cada página,</span> <span class="line">en su pliego.</span></h1>
    <p class="l-lede lede">
      Paginator calcula la imposición de tu revista, señala la página fuera de sitio y te deja hojear el ejemplar en
      3D antes de imprimir. Sin subir nada: todo ocurre en tu navegador.
    </p>
    <a class="l-action l-action--primary action" href="/app">
      Abrir Paginator
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </div>

  <div class="stageCell">
    <HeroMagazine client:idle />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    min-height: max(36rem, calc(100svh - var(--l-bar-h)));
  }

  .intro {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-6);
    padding: var(--space-12) var(--space-10) var(--space-16) var(--l-gutter);
  }

  .line {
    display: block;
  }

  .lede {
    max-width: 32rem;
  }

  .action {
    margin-top: var(--space-2);
  }

  .stageCell {
    min-height: 0;
  }

  @media (max-width: 1439px) {
    .hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    }

    .intro {
      padding-inline-end: var(--space-8);
    }
  }

  @media (max-width: 1199px) {
    .hero {
      grid-template-columns: minmax(0, 48fr) minmax(0, 52fr);
    }
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .intro {
      padding: var(--space-12) var(--l-gutter) var(--space-10);
    }

    .stageCell {
      height: min(36rem, 72svh);
    }
  }

  @media (max-width: 767px) {
    .intro {
      padding-top: var(--space-8);
      gap: var(--space-5);
    }

    .stageCell {
      height: calc(60.8vw + 12rem);
    }

    .action {
      width: 100%;
    }
  }
</style>
