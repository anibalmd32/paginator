---
import { CANTO_IMPOSITION, pageThumb } from './steps';

const SHEET_INDEX = 2;
const sheet = CANTO_IMPOSITION.sheets[SHEET_INDEX];
if (!sheet) throw new Error('La imposición de ejemplo no tiene el pliego 3.');
const count = CANTO_IMPOSITION.sheets.length;
const WRONG_FOLIO = 9;
const edge = 55 + (45 * sheet.indexInSignature) / Math.max(1, sheet.sheetsInSignature - 1);
---

<figure class="l-fig pliego">
  <figcaption class="visually-hidden">
    El pliego {sheet.number} de la revista de ejemplo: la cara lleva las páginas {sheet.front.left} y {sheet.front.right}, y el
    retiro la {sheet.back.left} y la {sheet.back.right}. Aviso en la cara: la página {sheet.front.right} lleva el folio {WRONG_FOLIO}.
  </figcaption>

  <div class="row" aria-hidden="true">
    <span class="alert l-play" style="--play: l-appear; --from: 64%; --to: 82%"></span>

    <div class="id">
      <span class="numeral">{sheet.number}</span>
      <span class="role">Tripa · {sheet.number}.º de {count}</span>
      <span class="edge" style={`width: ${String(Math.round(edge))}%`}></span>
    </div>

    <div class="flip">
      <div class="card l-play" style="--play: pliego-flip; --ease: cubic-bezier(0.5, 0, 0.3, 1); --from: 14%; --to: 60%">
        <div class="face">
          <p class="faceName"><b>Cara</b> exterior</p>
          <div class="pair">
            <span class="page"><img src={pageThumb(sheet.front.left)} alt="" width="420" height="594" loading="lazy" decoding="async" /></span>
            <span class="page">
              <img src={pageThumb(WRONG_FOLIO)} alt="" width="420" height="594" loading="lazy" decoding="async" />
              <span class="wrong l-play" style="--play: l-appear; --from: 64%; --to: 82%"></span>
            </span>
          </div>
          <p class="folios">
            <span>{sheet.front.left}</span>
            <span class="flagged">
              {sheet.front.right}
              <svg class="flag l-play" style="--play: l-appear; --from: 64%; --to: 82%" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path class="flagCloth" d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                <path class="flagPole" d="M4 22V2"></path>
              </svg>
            </span>
          </p>
        </div>
        <div class="face face--back">
          <p class="faceName"><b>Retiro</b> interior</p>
          <div class="pair">
            <span class="page"><img src={pageThumb(sheet.back.left)} alt="" width="420" height="594" loading="lazy" decoding="async" /></span>
            <span class="page"><img src={pageThumb(sheet.back.right)} alt="" width="420" height="594" loading="lazy" decoding="async" /></span>
          </div>
          <p class="folios">
            <span>{sheet.back.left}</span>
            <span>{sheet.back.right}</span>
          </p>
        </div>
      </div>
    </div>

    <p class="message l-play" style="--from: 68%; --to: 92%">
      <svg class="warn" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
        <path d="M12 9v4"></path>
        <path d="M12 17h.01"></path>
      </svg>
      <span>
        <b class="messageTitle">La página {sheet.front.right} lleva el folio {WRONG_FOLIO}</b>
        <span class="messageBody">En esa posición se esperaba el folio {sheet.front.right}. Reordénala o corrige el folio del archivo.</span>
      </span>
    </p>
  </div>
</figure>

<style>
  .pliego {
    width: fit-content;
    max-width: 100%;
  }

  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto auto;
    align-items: start;
    gap: 1.5em 3em;
    padding: 1.5em 1.75em;
  }

  .alert {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid var(--warning-rule);
    border-radius: var(--radius-lg);
    background: var(--warning-soft);
  }

  .id {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-top: 1.75rem;
  }

  .numeral {
    font-size: 2.75rem;
    font-stretch: var(--width-expanded);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-title);
    line-height: 0.9;
  }

  .role {
    color: var(--ink-2);
    font-size: var(--text-13);
    font-stretch: var(--width-condensed);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-dense);
    white-space: nowrap;
  }

  .edge {
    --fill: var(--stock-neutral);

    max-width: 7rem;
    height: 0.5rem;
    margin-top: var(--space-1);
    border-radius: 1px;
    background: var(--fill);
    box-shadow: inset 0 -1px 0 color-mix(in oklch, var(--fill) 72%, var(--ink));
  }

  .flip {
    width: 21em;
    perspective: 60em;
  }

  .card {
    position: relative;
    transform-style: preserve-3d;
  }

  .face {
    display: grid;
    gap: 0.5rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .face--back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }

  .faceName {
    color: var(--ink-2);
    font-size: var(--text-13);
    line-height: 1.25rem;
  }

  .faceName b {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  .pair {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--page-paper);
    box-shadow: 0 0 0 1px var(--rule-strong);
  }

  .pair::after {
    content: '';
    position: absolute;
    top: -0.375rem;
    bottom: -0.375rem;
    left: 50%;
    border-left: 1px dashed var(--ink);
  }

  .page {
    position: relative;
    aspect-ratio: 420 / 594;
  }

  .wrong {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 3px var(--warning);
  }

  .folios {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-28);
    font-stretch: var(--width-condensed);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-dense);
    line-height: 1;
  }

  .flagged {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .flagCloth {
    fill: var(--warning);
  }

  .flagPole {
    fill: none;
    stroke: var(--warning);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .message {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    padding-top: 1em;
    border-top: 1px solid var(--warning-rule);
    font-size: var(--text-14);
    line-height: 1.45;
  }

  .warn {
    margin-top: 1px;
    color: var(--warning);
  }

  .messageTitle {
    display: block;
    color: var(--warning-ink);
    font-weight: var(--weight-semibold);
  }

  .messageBody {
    display: block;
    color: var(--ink);
  }

  @keyframes pliego-flip {
    from {
      transform: rotateY(-180deg);
    }
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding: 1rem;
    }

    .id {
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-3);
      padding-top: 0;
    }

    .numeral {
      font-size: 2rem;
    }

    .edge {
      display: none;
    }

    .flip {
      justify-self: center;
      width: min(100%, 17rem);
    }

    .folios {
      font-size: var(--text-22);
    }
  }
</style>
