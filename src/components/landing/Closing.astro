---
import { ThemeToggle } from '@/components/shell/ThemeToggle';

const year = new Date().getFullYear();
---

<section class="closing" aria-labelledby="cierre-titulo">
  <div class="inner">
    <h2 class="l-display title" id="cierre-titulo">Mándala a imprenta sabiendo cómo va.</h2>
    <div class="side">
      <p class="text">Se abre en tu navegador, sin instalar nada. Tus archivos no salen de tu equipo.</p>
      <a class="l-action l-action--on-bar-primary action" href="/app">
        Abrir Paginator
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
  <footer class="colophon">
    <p>
      «Canto» es una revista ficticia generada para la demostración. <span class="brand">Paginator</span> · {year}
    </p>
    <nav class="legal" aria-label="Documentos legales">
      <a href="/privacidad">Privacidad</a>
      <a href="/condiciones">Condiciones de uso</a>
    </nav>
    <span class="theme"><ThemeToggle client:visible surface="bar" /></span>
  </footer>
</section>

<style>
  .closing {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    background: var(--bar);
    color: var(--on-bar);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: end;
    padding: 6rem var(--l-gutter);
  }

  .title {
    max-width: 13em;
  }

  .side {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-bottom: var(--space-2);
  }

  .text {
    max-width: 26rem;
    color: var(--on-bar-2);
    font-size: var(--text-18);
    line-height: 1.5;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-5) var(--l-gutter);
    border-top: 1px solid var(--bar-rule);
    color: var(--on-bar-2);
    font-size: var(--text-13);
  }

  .legal {
    display: flex;
    gap: var(--space-5);
  }

  .legal a {
    border-radius: var(--radius-sm);
    color: var(--on-bar-2);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal a:hover {
    color: var(--on-bar);
  }

  .legal a:focus-visible {
    outline: 2px solid var(--focus-on-bar);
    outline-offset: 2px;
  }

  .theme {
    display: none;
  }

  .brand {
    color: var(--on-bar);
    font-stretch: var(--width-expanded);
    font-weight: var(--weight-heavy);
  }

  @media (min-width: 64rem) and (min-height: 40rem) and (prefers-reduced-motion: no-preference) {
    .closing {
      min-height: calc(100svh - var(--l-bar-h));
    }

    .inner {
      align-content: center;
    }
  }

  @media (max-width: 1023px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      padding-block: var(--space-16);
    }
  }

  @media (max-width: 767px) {
    .inner {
      padding-block: var(--space-12);
    }

    .action {
      width: 100%;
    }

    .theme {
      display: flex;
      flex-basis: 100%;
    }
  }
</style>
