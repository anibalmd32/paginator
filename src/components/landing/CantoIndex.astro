---
import { CANTO_RUNS, LANDING_CANTO } from './sections';

const { slices, totalWeight, leafCount } = LANDING_CANTO;
const weights = slices.map((slice) => [slice.start, slice.weight]);
---

<nav class="canto" aria-label="Índice de la página" data-canto data-weights={JSON.stringify(weights)} data-leaves={leafCount}>
  <div class="track" style={`--total: ${String(totalWeight)}`}>
    {
      slices.map((slice) => (
        <span
          class="slice"
          data-leaf={slice.index}
          data-cover={slice.isCover ? '' : undefined}
          style={`--start: ${String(slice.start)}; --w: ${String(slice.weight)}; --rise: ${String(slice.rise)}; --fill: ${slice.fill}`}
        />
      ))
    }
    {
      CANTO_RUNS.map((run) => {
        const first = slices[run.firstLeaf];
        const last = slices[run.lastLeaf];
        const start = first?.start ?? 0;
        const end = (last?.start ?? 0) + (last?.weight ?? 1);
        const pages = `Págs. ${String(run.folio)}–${String(run.lastPage)}`;
        return (
          <a
            class="run"
            href={`#${run.id}`}
            data-run={run.id}
            data-first={run.firstLeaf}
            data-last={run.lastLeaf}
            style={`--start: ${String(start)}; --w: ${String(end - start)}`}
            aria-label={`${run.title} (${pages.toLowerCase()})`}
          >
            <span class="l-folio runFolio" aria-hidden="true">
              {run.folio}
            </span>
            <span class="tip" aria-hidden="true">
              <span class="tipPages">
                {pages} · {run.stockName}
              </span>
              <span class="tipTitle">{run.title}</span>
            </span>
          </a>
        );
      })
    }
    <span class="handle" aria-hidden="true"><span class="knob" /></span>
  </div>
</nav>

<script>
  const canto = document.querySelector<HTMLElement>('[data-canto]');
  const bar = document.querySelector<HTMLElement>('[data-landing-bar]');

  if (canto) {
    const track = canto.querySelector<HTMLElement>('.track');
    const slices = [...canto.querySelectorAll<HTMLElement>('.slice')];
    const runs = [...canto.querySelectorAll<HTMLAnchorElement>('.run')];
    const weights = JSON.parse(canto.dataset['weights'] ?? '[]') as [number, number][];
    const leafCount = Number(canto.dataset['leaves'] ?? slices.length);

    interface Region {
      run: HTMLAnchorElement;
      element: HTMLElement;
      first: number;
      last: number;
      top: number;
      bottom: number;
    }
    let regions: Region[] = [];
    let lastTurned = -1;
    let lastRun: HTMLAnchorElement | null = null;
    let frame = 0;

    const measure = (): void => {
      regions = runs.flatMap((run) => {
        const element = document.getElementById(run.dataset['run'] ?? '');
        if (!element) return [];
        const rect = element.getBoundingClientRect();
        const top = rect.top + window.scrollY;
        return [{ run, element, first: Number(run.dataset['first']), last: Number(run.dataset['last']), top, bottom: top + rect.height }];
      });
    };

    const toWeight = (position: number): number => {
      const clamped = Math.min(Math.max(position, 0), weights.length);
      const whole = Math.floor(clamped);
      const entry = weights[whole];
      if (!entry) {
        const lastEntry = weights[weights.length - 1];
        return lastEntry ? lastEntry[0] + lastEntry[1] : 0;
      }
      return entry[0] + (clamped - whole) * entry[1];
    };

    const update = (): void => {
      frame = 0;
      if (regions.length === 0 || !track) return;
      const probe = window.scrollY + window.innerHeight * 0.4;
      const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      let current = regions[0];
      for (const region of regions) if (probe >= region.top) current = region;
      if (!current) return;
      let position: number;
      if (atEnd) {
        position = leafCount;
        current = regions[regions.length - 1] ?? current;
      } else {
        const span = Math.max(1, current.bottom - current.top);
        const fraction = Math.min(1, Math.max(0, (probe - current.top) / span));
        position = current.first + fraction * (current.last - current.first + 1);
      }
      track.style.setProperty('--opening', String(toWeight(position)));
      const turned = Math.floor(position);
      if (turned !== lastTurned) {
        lastTurned = turned;
        for (const slice of slices) slice.toggleAttribute('data-turned', Number(slice.dataset['leaf']) < turned);
      }
      if (current.run !== lastRun) {
        lastRun?.removeAttribute('aria-current');
        current.run.setAttribute('aria-current', 'location');
        lastRun = current.run;
        for (const slice of slices) {
          const leaf = Number(slice.dataset['leaf']);
          slice.toggleAttribute('data-current', leaf >= current.first && leaf <= current.last);
        }
      }
      const hero = regions[0];
      if (bar && hero) bar.toggleAttribute('data-past-hero', window.scrollY + bar.offsetHeight >= hero.bottom - 1);
    };

    const request = (): void => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };
    const remeasure = (): void => {
      measure();
      request();
    };

    for (const run of runs) {
      const first = Number(run.dataset['first']);
      const last = Number(run.dataset['last']);
      const mark = (on: boolean): void => {
        for (const slice of slices) {
          const leaf = Number(slice.dataset['leaf']);
          if (leaf >= first && leaf <= last) slice.toggleAttribute('data-hover', on);
        }
      };
      run.addEventListener('pointerenter', () => mark(true));
      run.addEventListener('pointerleave', () => mark(false));
      run.addEventListener('focus', () => mark(true));
      run.addEventListener('blur', () => mark(false));
    }

    measure();
    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(remeasure).observe(document.body);
  }
</script>

<style>
  .canto {
    --slice-w: 1.375rem;
    --rise-room: 5px;
    --gap: 14px;

    position: fixed;
    top: var(--l-bar-h);
    right: 0;
    bottom: 0;
    z-index: var(--z-sticky);
    width: var(--l-canto-w);
    border-left: 1px solid var(--rule);
    background: var(--paper);
  }

  .track {
    --u: calc((100% - var(--gap)) / var(--total));

    position: absolute;
    top: 50%;
    right: 0.375rem;
    width: var(--slice-w);
    height: min(calc(100% - 4rem), 30rem);
    translate: 0 -50%;
  }

  .slice {
    --edge: color-mix(in oklch, var(--fill) 72%, var(--ink));

    position: absolute;
    left: 0;
    right: calc((1 - var(--rise)) * var(--rise-room));
    top: calc(var(--start) * var(--u));
    height: max(1px, calc(var(--w) * var(--u)));
    background: var(--fill);
    box-shadow: inset 0 -1px 0 var(--edge);
    pointer-events: none;
    transition:
      translate var(--dur) var(--ease-out),
      right var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .slice:not([data-turned]) {
    translate: 0 var(--gap);
  }

  .slice[data-current] {
    right: -6px;
    box-shadow:
      inset 0 -1px 0 var(--edge),
      inset -3px 0 0 var(--petrol-ink);
  }

  .slice[data-hover]:not([data-current]) {
    right: -5px;
    box-shadow:
      inset 0 -1px 0 var(--edge),
      inset -2px 0 0 var(--ink);
  }

  .run {
    position: absolute;
    left: -1.5rem;
    right: -0.375rem;
    top: calc(var(--start) * var(--u));
    height: calc(var(--w) * var(--u) + var(--gap));
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
  }

  .run:focus-visible {
    outline-offset: -2px;
  }

  .runFolio {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.25rem;
    color: var(--ink-3);
    font-size: var(--text-12);
    text-align: end;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .run[aria-current] .runFolio,
  .run:hover .runFolio {
    color: var(--petrol-ink);
  }

  .tip {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.5rem);
    display: grid;
    gap: 2px;
    width: max-content;
    max-width: 16rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--paper-float);
    color: var(--ink);
    box-shadow: var(--shadow-float);
    font-size: var(--text-13);
    line-height: 1.3;
    opacity: 0;
    visibility: hidden;
    translate: 4px -50%;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out),
      visibility 0s linear var(--dur-fast);
  }

  .run:hover .tip,
  .run:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    translate: 0 -50%;
    transition-delay: 0s;
  }

  .tipPages {
    color: var(--ink-2);
    font-size: var(--text-12);
    font-stretch: var(--width-condensed);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-dense);
  }

  .tipTitle {
    font-weight: var(--weight-semibold);
  }

  .handle {
    position: absolute;
    left: -5px;
    right: -5px;
    top: calc(var(--opening, 0) * var(--u));
    height: var(--gap);
    display: grid;
    align-items: center;
    pointer-events: none;
  }

  .knob {
    height: calc(var(--gap) - 8px);
    border-radius: 3px;
    background: var(--petrol);
    box-shadow: var(--shadow-handle);
  }

  @media (max-width: 1023px) {
    .canto {
      --slice-w: 1.125rem;
    }
  }

  @media (max-width: 767px) {
    .canto {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slice,
    .tip {
      transition-property: opacity;
    }
  }
</style>
