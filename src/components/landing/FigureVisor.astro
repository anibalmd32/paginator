---
import { CANTO_IMPOSITION, pageFull } from './steps';

const SHEET_INDEX = 2;
const sheet = CANTO_IMPOSITION.sheets[SHEET_INDEX];
if (!sheet) throw new Error('La imposición de ejemplo no tiene el pliego 3.');
const count = CANTO_IMPOSITION.sheets.length;

const W = 270;
const H = 202;
const M = 19;
const TICK = 11;
const GAP = 4;
const left = M;
const right = W - M;
const top = M;
const bottom = H - M;
const middle = W / 2;

type Segment = readonly [number, number, number, number];
type Point = readonly [number, number];

const crop: readonly Segment[] = [
  [left - GAP - TICK, top, left - GAP, top],
  [left, top - GAP - TICK, left, top - GAP],
  [right + GAP, top, right + GAP + TICK, top],
  [right, top - GAP - TICK, right, top - GAP],
  [left - GAP - TICK, bottom, left - GAP, bottom],
  [left, bottom + GAP, left, bottom + GAP + TICK],
  [right + GAP, bottom, right + GAP + TICK, bottom],
  [right, bottom + GAP, right, bottom + GAP + TICK],
];
const fold: readonly Segment[] = [
  [middle, top - GAP - TICK, middle, top - GAP],
  [middle, bottom + GAP, middle, bottom + GAP + TICK],
];
const targets: readonly Point[] = [
  [M / 2, H / 2],
  [W - M / 2, H / 2],
];
---

<figure class="l-fig despiece">
  <figcaption class="visually-hidden">
    El pliego {sheet.number} de la revista de ejemplo, extendido por el retiro: las páginas {sheet.back.left} y {sheet.back.right}
    a ambos lados del pliegue, con marcas de corte, de plegado y de registro.
  </figcaption>

  <div class="scene" aria-hidden="true">
    <p class="guide">
      Pliego <b class="guideNum">{sheet.number}</b> de {count}
      <span class="dot">·</span>
      <b>Retiro</b>
      <span class="dot">·</span>
      págs. <b class="guidePages">{sheet.back.left} | {sheet.back.right}</b>
    </p>

    <div class="table">
      <div class="plane l-play" style="--play: despiece-tilt; --ease: cubic-bezier(0.4, 0, 0.25, 1); --from: 8%; --to: 70%">
        <div class="stock l-play" style="--play: l-appear; --from: 54%; --to: 88%">
          <svg class="marks" viewBox={`0 0 ${String(W)} ${String(H)}`} fill="none" aria-hidden="true" focusable="false">
            {crop.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
            {fold.map(([x1, y1, x2, y2]) => <line class="foldMark" x1={x1} y1={y1} x2={x2} y2={y2} />)}
            {
              targets.map(([cx, cy]) => (
                <g>
                  <circle cx={cx} cy={cy} r="3.2" />
                  <line x1={cx - 6} y1={cy} x2={cx + 6} y2={cy} />
                  <line x1={cx} y1={cy - 6} x2={cx} y2={cy + 6} />
                </g>
              ))
            }
          </svg>
          <span class="slug">Pliego {sheet.number}/{count} · Retiro · págs. {sheet.back.left} | {sheet.back.right}</span>
          <span class="slug slug--end">Cuadernillo 1</span>
        </div>
        <div class="spread">
          <img src={pageFull(sheet.back.left)} alt="" width="990" height="1400" loading="lazy" decoding="async" />
          <img src={pageFull(sheet.back.right)} alt="" width="990" height="1400" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  .despiece {
    width: 100%;
    max-width: 32em;
  }

  .scene {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .guide {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-lg);
    background: var(--paper-float);
    color: var(--ink-2);
    box-shadow: var(--shadow-float);
    font-size: var(--text-13);
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
    white-space: nowrap;
  }

  .guide b {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  .guide .guideNum {
    font-size: var(--text-18);
    font-stretch: var(--width-expanded);
    font-weight: var(--weight-heavy);
    line-height: 1;
  }

  .guide .guidePages {
    font-size: var(--text-16);
    font-stretch: var(--width-condensed);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-dense);
  }

  .dot {
    color: var(--ink-3);
  }

  .table {
    width: 100%;
    perspective: 64em;
    perspective-origin: 50% 20%;
  }

  .plane {
    position: relative;
    aspect-ratio: 270 / 202;
    transform-origin: 50% 62%;
  }

  .stock {
    position: absolute;
    inset: 0;
    background: var(--page-paper);
    box-shadow: var(--shadow-float);
  }

  .marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--page-ink-muted);
    stroke-width: 0.45;
  }

  .foldMark {
    stroke-dasharray: 1.6 1.2;
  }

  .slug {
    position: absolute;
    top: 3%;
    left: 8.6%;
    color: var(--page-ink-muted);
    font-size: 0.55em;
    line-height: 1;
    white-space: nowrap;
  }

  .slug--end {
    right: 8.6%;
    left: auto;
  }

  .spread {
    position: absolute;
    inset: 9.406% 7.037%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--page-paper);
  }

  @keyframes despiece-tilt {
    from {
      transform: rotateX(57deg) rotateZ(-5deg) scale(0.92);
    }
  }

  @media (max-width: 767px) {
    .despiece {
      max-width: 32rem;
    }

    .scene {
      gap: 1rem;
    }

    .slug {
      display: none;
    }
  }
</style>
