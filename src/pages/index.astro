---
import CantoIndex from '@/components/landing/CantoIndex.astro';
import Closing from '@/components/landing/Closing.astro';
import Hero from '@/components/landing/Hero.astro';
import LandingDocument from '@/components/landing/LandingDocument.astro';
import SectionCarga from '@/components/landing/SectionCarga.astro';
import SectionError from '@/components/landing/SectionError.astro';
import SectionImposicion from '@/components/landing/SectionImposicion.astro';
import SectionLocal from '@/components/landing/SectionLocal.astro';
import SectionVisor from '@/components/landing/SectionVisor.astro';
import TopBar from '@/components/landing/TopBar.astro';
---

<LandingDocument
  title="Paginator · imposición y verificación de revistas en el navegador"
  description="Calcula la imposición de tu revista, encuentra la página fuera de sitio en su pliego y hojea el ejemplar en 3D antes de imprimir. Sin subir archivos: todo ocurre en tu navegador."
  ogImage="/landing/app/pliegos-error-light.png"
  ogImageAlt="Matriz de pliegos de Paginator señalando que la página 5 lleva el folio 9."
>
  <TopBar />
  <div class="l-page">
    <main id="contenido">
      <Hero />
      <SectionImposicion />
      <SectionCarga />
      <SectionError />
      <SectionVisor />
      <SectionLocal />
      <Closing />
    </main>
  </div>
  <CantoIndex />
</LandingDocument>
